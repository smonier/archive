# The `yarn jahia-deploy` will load environment variables from this file
# if it exists. You can see the default values below:
JAHIA_USER=root:root
JAHIA_HOST=http://localhost:8080
# We recommend creating a dedicated user for CI/CD deployments, with only the
# necessary permissions.
UNOMI_HOST=http://localhost:8181
# User directory configuration
USER_DIRECTORY_API_URL=https://randomuser.me/api/
USER_DIRECTORY_RESULTS=100
